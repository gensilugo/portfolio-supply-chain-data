{
  "name": "Control de frescura — Frente de estiba",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 8 * * *" }
          ]
        }
      },
      "name": "Todos los días 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "read",
        "sheetId": "REEMPLAZAR_CON_ID_DE_PLANILLA",
        "range": "FrenteDeEstiba!A2:F"
      },
      "name": "Leer frente de estiba",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Para cada lote: fecha de bloqueo = vencimiento - dias_bloqueo (o fecha de waiver si existe)\n// dias_para_agotarse = stock_actual / ritmo_salida_diario\n// riesgo = dias_para_agotarse > dias_hasta_bloqueo\nreturn items.map(item => {\n  const { vencimiento, dias_bloqueo, waiver, stock_actual, ritmo_salida } = item.json;\n  const fechaBloqueo = waiver || sumarDias(vencimiento, -dias_bloqueo);\n  const diasHastaBloqueo = diferenciaEnDias(fechaBloqueo, hoy());\n  const diasParaAgotarse = stock_actual / ritmo_salida;\n  item.json.en_riesgo = diasParaAgotarse > diasHastaBloqueo;\n  item.json.fecha_bloqueo = fechaBloqueo;\n  return item;\n});"
      },
      "name": "Calcular frescura y bloqueo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.en_riesgo }}", "value2": true }
          ]
        }
      },
      "name": "¿Hay productos en riesgo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "sendTo": "REEMPLAZAR_CON_MAIL_DESTINO",
        "subject": "Alerta de frescura — lotes en riesgo de bloqueo",
        "message": "Se detectaron lotes en riesgo de bloqueo. Ver detalle adjunto y priorizar salida."
      },
      "name": "Enviar alerta de frescura",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1140, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "REEMPLAZAR_CON_ID_DE_PLANILLA",
        "range": "HistorialAlertas!A:E"
      },
      "name": "Registrar en historial",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [1360, 200]
    }
  ],
  "connections": {

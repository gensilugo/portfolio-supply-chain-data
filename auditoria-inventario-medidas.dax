// Auditoría de Inventario · medidas DAX
// Modelo: Recuentos (una fila por SKU por recuento, con stock físico y lógico)

Unidades Fisicas =
SUM( Recuentos[stock_fisico] )

Unidades Logicas =
SUM( Recuentos[stock_logico] )

Unidades Faltantes =
SUMX( Recuentos, MAX( Recuentos[stock_logico] - Recuentos[stock_fisico], 0 ) )

Unidades Sobrantes =
SUMX( Recuentos, MAX( Recuentos[stock_fisico] - Recuentos[stock_logico], 0 ) )

Diferencia Neta =
[Unidades Sobrantes] - [Unidades Faltantes]

Precision Neta % =
// compensa faltantes con sobrantes dentro de la misma categoría
// en vez de sumar el valor absoluto de cada diferencia
1 - DIVIDE(
    SUMX( Recuentos, ABS( Recuentos[stock_fisico] - Recuentos[stock_logico] ) ) / 2,
    [Unidades Logicas]
)

SKUs Relevados =
DISTINCTCOUNT( Recuentos[sku] )

Precision Neta % vs Objetivo =
VAR Objetivo = 0.97
RETURN
    [Precision Neta %] - Objetivo
